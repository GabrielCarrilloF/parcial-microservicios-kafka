# Copie este archivo como .environments/application-secrets.properties
# (la carpeta .environments esta en .gitignore: nunca se sube a GitHub).

# TiDB (TiDB Cloud > Connect)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=crud_usuarios
DB_USERNAME=REEMPLAZAR.root
DB_PASSWORD=REEMPLAZAR
DB_SSL_MODE=REQUIRED

# RabbitMQ (CloudAMQP > AMQP URL)
RABBITMQ_URL=amqps://usuario:clave@host.rmq.cloudamqp.com/vhost
