# Copie este archivo como .environments/application-secrets.properties.
# Reemplace todos los valores de ejemplo. Nunca versionar el archivo real.

# Base de datos local
db.host=localhost
db.port=3306
db.name=crud_usuarios
db.username=root
db.password=REEMPLAZAR

# JWT: Base64 de al menos 32 bytes aleatorios
jwt.secret=REEMPLAZAR

# RabbitMQ (CloudAMQP > AMQP URL)
spring.rabbitmq.addresses=amqps://usuario:clave@host.rmq.cloudamqp.com/vhost

# Microservicio accounts
accounts.base-url=http://localhost:8081
